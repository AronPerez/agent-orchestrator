#!/usr/bin/env bash
# Pre-commit: catch formatting problems here instead of in a red PR.
#
# What this mirrors:
#   .github/workflows/go.yml  → gofmt on Go files.  Mirrored exactly; a failure
#                               here is a real CI failure.
#
# That is the whole hook, on purpose. A prettier --check ran here until this
# commit and enforced nothing: `.github/workflows/prettier.yml`, `.prettierrc`
# and `.prettierignore` were all deleted together in f7a5923 ("chore: remove
# partial prettier setup", #3090), so it was left running prettier's built-in
# defaults against a repo that had removed that setup — flagging files nobody
# touched, and disagreeing with upstream's own formatting on every sync. It also
# made --no-verify (needed for every upstream sync merge) the only way to
# commit, which silently switched off the gofmt check below along with it.
#
# Enable once per clone (scripts/dev-setup.sh and scripts/install-hooks.sh do
# this for you):
#   git config core.hooksPath .githooks
#
# This checks and blocks; it never rewrites your working tree, so a
# partially-staged file is safe. To auto-fix instead, run the printed command
# (or flip gofmt -l→-w and re-stage).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Staged, non-deleted paths, NUL-delimited so spaces/newlines are safe.
# (while-read, not mapfile -d: macOS ships bash 3.2, which lacks mapfile -d.)
staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done \
	< <(git diff --cached --name-only -z --diff-filter=d)
[ ${#staged[@]} -eq 0 ] && exit 0

fail=0

# gofmt — Go files only.
go_files=()
for f in "${staged[@]}"; do
	case "$f" in *.go) go_files+=("$f") ;; esac
done
if [ ${#go_files[@]} -gt 0 ] && command -v gofmt >/dev/null 2>&1; then
	unformatted="$(gofmt -l "${go_files[@]}")"
	if [ -n "$unformatted" ]; then
		echo "" >&2
		echo "✖ gofmt needed:" >&2
		echo "$unformatted" | sed 's/^/    /' >&2
		echo "  fix with:  gofmt -w <files>   (then re-stage)" >&2
		fail=1
	fi
fi

exit "$fail"
